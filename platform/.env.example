# ============================================================
# Fun.Run V2 Platform — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# ── Node ────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── API Gateway ─────────────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
TRADING_SERVICE_URL=http://localhost:3003
INDEXER_METRICS_URL=http://localhost:9091/metrics
WS_GATEWAY_HTTP_URL=http://localhost:3002

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql://funrun:secret@localhost:5432/funrun_dev
DATABASE_URL_REPLICA=postgresql://funrun:secret@localhost:5433/funrun_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_PUBSUB=1
REDIS_DB_BULLMQ=2

# ── BullMQ ──────────────────────────────────────────────────
BULLMQ_CONCURRENCY_TRADE=20
BULLMQ_CONCURRENCY_GRADUATION=5
BULLMQ_CONCURRENCY_NOTIFICATION=50

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-long-secret-key
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── Solana ──────────────────────────────────────────────────
SOLANA_RPC_PRIMARY=https://api.devnet.solana.com
SOLANA_RPC_FALLBACK=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_NETWORK=devnet
PROGRAM_ID=HX1TXtjJ31aCA9AQZSUFzzyBVj34qh1uHGvcNUd2oBqP

# ── Encryption ──────────────────────────────────────────────
MNEMONIC_ENCRYPTION_KEY=change-me-32-byte-aes-256-gcm-key
TREASURY_KEYPAIR_PATH=/run/secrets/treasury_keypair

# ── Privy ───────────────────────────────────────────────────
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# ── IPFS / Pinata ───────────────────────────────────────────
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# ── PostgreSQL (Docker Compose) ───────────────────────────────
POSTGRES_DB=funrun
POSTGRES_USER=funrun
POSTGRES_PASSWORD=change-me-strong-password

# ── Trading Service ─────────────────────────────────────────
# offchain = DB AMM (default) | onchain = Solana executors
TRADING_MODE=offchain
PORT=3003
# degraded = fail-open on Redis outage (default) | strict = fail-closed (production)
REDIS_DEPENDENCY_MODE=degraded
# Require Idempotency-Key on POST /trade/buy and /trade/sell (set true in production)
REQUIRE_TRADE_IDEMPOTENCY_KEY=false
# Redis leader election for background workers (tx-confirmer, reconciler, graduation crank)
WORKER_LEADER_ELECTION=true

# ── Indexer Service ─────────────────────────────────────────
# Same REDIS_DEPENDENCY_MODE and WORKER_LEADER_ELECTION apply to indexer
INDEXER_METRICS_PORT=9091

# ── WebSocket Gateway ───────────────────────────────────────
WS_PORT=3001
HTTP_PORT=3002
PRIVY_APP_ID=
PRIVY_APP_SECRET=
TREASURY_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
NETWORK=devnet
MONITORING_PORT=9090

# ── Fee Configuration ───────────────────────────────────────
TRADING_FEE_BPS=150
CREATION_FEE_LAMPORTS=20000000
CREATOR_FEE_PCT=40
REFERRER_FEE_PCT=20
TREASURY_FEE_PCT=40

# ── Monitoring ──────────────────────────────────────────────
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=

# ── Notifications ───────────────────────────────────────────
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.funrun.app
