{
  "title": "Fun.Run Trading Service",
  "uid": "funrun-trading-v1",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["funrun", "trading", "solana"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Uptime",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "funrun_process_uptime_seconds",
          "legendFormat": "uptime"
        }
      ],
      "options": {
        "unit": "s",
        "thresholds": {
          "steps": [
            { "color": "red",    "value": null },
            { "color": "yellow", "value": 60 },
            { "color": "green",  "value": 300 }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Trade Attempts / min",
      "type": "timeseries",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "rate(funrun_trade_attempts_total[1m]) * 60",
          "legendFormat": "{{ operation }}"
        }
      ],
      "options": { "unit": "short" }
    },
    {
      "id": 3,
      "title": "Trade Error Rate %",
      "type": "timeseries",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "rate(funrun_trade_completed_total{status=\"error\"}[5m]) / (rate(funrun_trade_attempts_total[5m]) + 1e-9) * 100",
          "legendFormat": "{{ operation }} error %"
        }
      ],
      "options": { "unit": "percent" }
    },
    {
      "id": 4,
      "title": "Trade Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(funrun_trade_duration_ms_bucket[5m]))",
          "legendFormat": "p50 {{ operation }}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(funrun_trade_duration_ms_bucket[5m]))",
          "legendFormat": "p95 {{ operation }}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(funrun_trade_duration_ms_bucket[5m]))",
          "legendFormat": "p99 {{ operation }}"
        }
      ],
      "options": { "unit": "ms" }
    },
    {
      "id": 5,
      "title": "Tx Confirmation Latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(funrun_tx_confirmation_ms_bucket[5m]))",
          "legendFormat": "p50 confirmation"
        },
        {
          "expr": "histogram_quantile(0.95, rate(funrun_tx_confirmation_ms_bucket[5m]))",
          "legendFormat": "p95 confirmation"
        }
      ],
      "options": { "unit": "ms" }
    },
    {
      "id": 6,
      "title": "Tx by Status",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "funrun_tx_by_status",
          "legendFormat": "{{ status }}"
        }
      ],
      "options": { "unit": "short", "orientation": "horizontal" }
    },
    {
      "id": 7,
      "title": "Tx Failed / Expired (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "rate(funrun_tx_failed_total[1m]) * 60",
          "legendFormat": "failed {{ error_code }}"
        },
        {
          "expr": "rate(funrun_tx_expired_total[1m]) * 60",
          "legendFormat": "expired"
        }
      ],
      "options": { "unit": "short" }
    },
    {
      "id": 8,
      "title": "Graduation Queue",
      "type": "stat",
      "gridPos": { "x": 16, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "funrun_graduation_coins_queued",
          "legendFormat": "graduating coins"
        }
      ],
      "options": {
        "unit": "short",
        "thresholds": {
          "steps": [
            { "color": "green",  "value": null },
            { "color": "yellow", "value": 5 },
            { "color": "red",    "value": 10 }
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Graduation Dispatch Error Rate %",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "rate(funrun_graduation_dispatches_total{status=\"error\"}[5m]) / (rate(funrun_graduation_dispatches_total{status=\"attempt\"}[5m]) + 1e-9) * 100",
          "legendFormat": "{{ phase }} error %"
        }
      ],
      "options": { "unit": "percent" }
    },
    {
      "id": 10,
      "title": "RPC Error Rate %",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(funrun_rpc_requests_total{result=\"failure\"}[5m]) / (rate(funrun_rpc_requests_total[5m]) + 1e-9) * 100",
          "legendFormat": "{{ endpoint }} error %"
        }
      ],
      "options": { "unit": "percent" }
    },
    {
      "id": 11,
      "title": "RPC Latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(funrun_rpc_latency_ms_bucket[5m]))",
          "legendFormat": "p95 {{ endpoint }}"
        }
      ],
      "options": { "unit": "ms" }
    },
    {
      "id": 12,
      "title": "RPC Circuit Breaker",
      "type": "state-timeline",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "funrun_rpc_circuit_open",
          "legendFormat": "{{ endpoint }}"
        }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "valueMapping": [
          { "value": "0", "text": "CLOSED" },
          { "value": "1", "text": "OPEN" }
        ]
      }
    },
    {
      "id": 13,
      "title": "Active WS Subscriptions",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "funrun_ws_subscriptions_active",
          "legendFormat": "active subscriptions"
        }
      ],
      "options": { "unit": "short" }
    },
    {
      "id": 14,
      "title": "Reconciler Runs / Orphans Found (rate/min)",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "rate(funrun_reconciler_runs_total[1m]) * 60",
          "legendFormat": "runs/min"
        },
        {
          "expr": "rate(funrun_reconciler_orphans_total[1m]) * 60",
          "legendFormat": "orphans/min"
        },
        {
          "expr": "rate(funrun_reconciler_stuck_submitted_total[1m]) * 60",
          "legendFormat": "stuck-submitted/min"
        }
      ],
      "options": { "unit": "short" }
    }
  ]
}
