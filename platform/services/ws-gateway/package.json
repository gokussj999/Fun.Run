{
  "name": "@funrun/ws-gateway",
  "version": "0.1.0",
  "description": "Fun.Run real-time WebSocket gateway",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@privy-io/server-auth": "^1.17.0",
    "@funrun/config": "workspace:*",
    "@funrun/database": "workspace:*",
    "@funrun/logger": "workspace:*",
    "@funrun/redis": "workspace:*",
    "@funrun/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
